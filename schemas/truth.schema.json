{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditenv/truth.schema.json",
  "description": "grader/truth.json - never visible to the agent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "issues", "tolerance_minor"],
  "properties": {
    "episode_id": {"type": "string"},
    "tolerance_minor": {"type": "integer", "minimum": 0, "maximum": 49, "description": "amount tolerance used by the matcher (from config.tolerance_minor)"},
    "issues": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_id", "type", "affected_ids", "expected_amount_minor", "currency", "evidence_sets"],
        "properties": {
          "issue_id": {"type": "string", "pattern": "^ISS-[0-9]{3}$"},
          "type": {"enum": ["duplicate_invoice", "payment_allocation", "fx_rate", "period_cutoff", "vat_error"]},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "expected_amount_minor": {"type": "integer", "minimum": 1},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "evidence_sets": {"type": "array", "minItems": 1, "maxItems": 3,
                            "items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string"}}}
        }
      }
    }
  }
}
