{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditenv/fx.schema.json",
  "description": "One row of fx.csv. rate = units of target per 1 unit of source, decimal string. Tools add fx_id = fx:DATE:SRC:TGT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "source_currency", "target_currency", "rate"],
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "target_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "rate": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "fx_id": {"type": "string", "pattern": "^fx:\\d{4}-\\d{2}-\\d{2}:[A-Z]{3}:[A-Z]{3}$"}
  }
}
